{
  "name": "hybrd",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "bun run --cwd server dev",
    "start": "bun run --cwd server start",
    "typecheck": "bun run --cwd server typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun run --cwd server test",
    "test:integration": "bun run --cwd server test:integration",
    "check": "bun run lint && bun run typecheck && bun run test && bun run openapi:check",
    "db:generate": "bun run --cwd server db:generate",
    "db:migrate": "bun run --cwd server db:migrate",
    "db:seed": "bun run --cwd server db:seed",
    "openapi:generate": "bun run --cwd server openapi:generate",
    "openapi:check": "bun run --cwd server openapi:check",
    "ops": "bun run --cwd server ops"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
