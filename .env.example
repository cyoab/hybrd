# Local development only. make setup generates a unique auth secret in .env.
NODE_ENV=development
API_PORT=3000
POSTGRES_PORT=54329
POSTGRES_USER=hybrd
POSTGRES_PASSWORD=hybrd_local
POSTGRES_DB=hybrd

# Host-side Bun uses localhost. Compose supplies its internal database URL.
DATABASE_URL=postgres://hybrd:hybrd_local@localhost:54329/hybrd
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUSTED_ORIGINS=http://localhost:3000
# Local email/password sessions use the real auth stack. Forbidden in production.
DEV_AUTH_ENABLED=true

# Optional Apple credentials. All three are required to enable the provider.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Reserved for the gateway implementation; no provider requests are made yet.
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
OPENROUTER_LLM_MODEL=
