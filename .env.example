# Local development only. make setup generates a unique auth secret in .env.
NODE_ENV=development
API_PORT=3000
POSTGRES_PORT=54329
POSTGRES_USER=hybrd
POSTGRES_PASSWORD=hybrd_local
POSTGRES_DB=hybrd

# Host-side Bun uses localhost. Compose supplies its internal database URL.
DATABASE_URL=postgres://hybrd:hybrd_local@localhost:54329/hybrd
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUSTED_ORIGINS=http://localhost:3000
# Local email/password sessions use the real auth stack. Forbidden in production.
DEV_AUTH_ENABLED=true

# Optional Apple credentials. All three are required to enable the provider.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Optional cloud intelligence. Real requests require consent and an entitlement.
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
OPENROUTER_LLM_MODEL=

AI_REQUIRED_ENTITLEMENT=pro
AI_DECISIONS_PER_DAY=100
AI_CHATS_PER_DAY=30
AI_REQUESTS_PER_MINUTE=10

# StoreKit server verification. Supply bundle ID + certificates together.
STOREKIT_BUNDLE_ID=
STOREKIT_APP_APPLE_ID=
STOREKIT_ENVIRONMENT=Sandbox
# Set to certificates/AppleRootCA-G3.cer (paths relative to server/).
STOREKIT_ROOT_CERTIFICATES=
# JSON mapping of your real subscription product IDs to entitlement keys.
STOREKIT_PRODUCTS={}

# APNs: all four required; mount the private key and keep it out of the repo.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=
