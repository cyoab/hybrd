# Local development only. make setup generates a unique auth secret in .env.
NODE_ENV=development
API_PORT=3000
POSTGRES_PORT=54329
POSTGRES_USER=hybrd
POSTGRES_PASSWORD=hybrd_local
POSTGRES_DB=hybrd

# Host-side Bun uses localhost. Compose supplies its internal database URL.
DATABASE_URL=postgres://hybrd:hybrd_local@localhost:54329/hybrd
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
TRUSTED_ORIGINS=http://localhost:3000
# Local email/password sessions use the real auth stack. Forbidden in production.
DEV_AUTH_ENABLED=false

# Compose always routes email to Mailpit and disables password sign-in.
# Host Bun development: use mailpit and start the mailpit Compose service.
# Production: use resend, a verified sending domain, and RESEND_API_KEY.
AUTH_EMAIL_TRANSPORT=mailpit
AUTH_EMAIL_FROM=signin@hybrd.test
MAILPIT_URL=http://localhost:8025
MAILPIT_PORT=8025
RESEND_API_KEY=

# Google web OAuth client + optional additional iOS token audience.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

# Optional Apple credentials. All three are required to enable the provider.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Optional Strava: backend history previews and automatic workout publishing.
# Leave client credentials empty to disable. See docs/strava-integration.md.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_APP_RETURN_URL=hybrd://integrations/strava
# Public webhook path secret (32+ URL-safe chars) and a separate verify token.
# Add the subscription ID after Strava completes the GET verification handshake.
STRAVA_WEBHOOK_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

# Optional cloud intelligence. Real requests require consent and an entitlement.
OPENROUTER_API_KEY=
OPENROUTER_JEV_MODEL=~typesafe/jev-latest
OPENROUTER_LLM_MODEL=

AI_REQUIRED_ENTITLEMENT=pro
AI_DECISIONS_PER_DAY=100
AI_CHATS_PER_DAY=30
AI_REQUESTS_PER_MINUTE=10

# StoreKit server verification. Supply bundle ID + certificates together.
STOREKIT_BUNDLE_ID=
STOREKIT_APP_APPLE_ID=
STOREKIT_ENVIRONMENT=Sandbox
# Set to certificates/AppleRootCA-G3.cer (paths relative to server/).
STOREKIT_ROOT_CERTIFICATES=
# JSON mapping of your real subscription product IDs to entitlement keys.
STOREKIT_PRODUCTS={}

# APNs: all four required; mount the private key and keep it out of the repo.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TOPIC=
