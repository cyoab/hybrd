{
  "name": "@hybrd/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 30000 tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "openapi:generate": "bun openapi/generate.ts",
    "openapi:check": "bun openapi/generate.ts --check",
    "ops": "bun src/ops/cli.ts",
    "email:preview": "bun scripts/preview-email.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@hono/zod-openapi": "1.6.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
