          }
        }
      }
    },
    "Build time on your feet at a conversational effort. Keep enough in reserve for your next strength session.": {
      "extractionState": "manual",
      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build time on your feet at a conversational effort. Keep enough in reserve for your next strength session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acumula tiempo corriendo a un esfuerzo que te permita conversar. Guarda energía para tu próxima sesión de fuerza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acumule tempo correndo em um esforço que permita conversar. Guarde energia para o próximo treino de força."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prolongez votre course à une intensité permettant de parler. Gardez de l’énergie pour votre prochaine séance de musculation."
          }
