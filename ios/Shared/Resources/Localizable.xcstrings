    "%lld sets will be saved. Unchecked sets won’t be recorded, and your prescription stays unchanged.": {
      "extractionState": "manual",
      "comment": "Used in: WorkoutLoggerView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sets will be saved. Unchecked sets won’t be recorded, and your prescription stays unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardarán %lld series. Las series sin marcar no se registrarán y la prescripción no cambiará."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serão salvas %lld séries. Séries não marcadas não serão registradas, e sua prescrição não será alterada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld séries seront enregistrées. Les séries non cochées ne seront pas enregistrées et la prescription restera inchangée."
          }
        }
      }
    },
    "%lld sets · %lld reps": {
      "extractionState": "manual",
      "comment": "Used in: ContentView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@sets@ · %#@reps@"
