          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has registrado %lld sesiones: %@ de carrera y %lld sesiones de fuerza. Estos totales reflejan tus resultados guardados. Se necesita más historial para evaluar una tendencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você registrou %lld sessões: %@ de corrida e %lld sessões de força. Esses totais refletem os resultados salvos. É preciso um histórico maior para avaliar uma tendência."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez enregistré %lld séances : %@ de course et %lld séances de musculation. Ces totaux reflètent vos résultats enregistrés. Un historique plus long est nécessaire pour évaluer une tendance."
          }
        }
      }
