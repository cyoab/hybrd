      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional upper-body work after your key run. Keep three reps in reserve and skip it if you need more recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo opcional de tren superior tras tu carrera clave. Deja tres repeticiones en reserva y omítelo si necesitas más recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
