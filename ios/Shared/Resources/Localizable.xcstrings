    "Open hybrd on your Apple Watch, choose this session, then tap Start run. Let the plan finish syncing before you leave.": {
      "extractionState": "manual",
      "comment": "Used in: RunSessionView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open hybrd on your Apple Watch, choose this session, then tap Start run. Let the plan finish syncing before you leave."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre hybrd en el Apple Watch, elige esta sesión y toca Iniciar carrera. Espera a que el plan termine de sincronizarse antes de salir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o hybrd no Apple Watch, escolha esta sessão e toque em Iniciar corrida. Espere o plano terminar de sincronizar antes de sair."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez hybrd sur votre Apple Watch, choisissez cette séance, puis touchez Démarrer la course. Attendez la fin de la synchronisation avant de partir."
