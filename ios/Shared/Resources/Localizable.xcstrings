    "Build smoothly. Heart rate can lag on short reps; do not sprint to chase the zone.": {
      "extractionState": "manual",
      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build smoothly. Heart rate can lag on short reps; do not sprint to chase the zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el esfuerzo gradualmente. La frecuencia cardíaca puede tardar en responder en intervalos cortos; no aceleres al máximo para alcanzar la zona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente o esforço gradualmente. A frequência cardíaca pode demorar a responder em intervalos curtos; não dê um sprint para alcançar a zona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez progressivement l’effort. La fréquence cardiaque peut réagir tardivement sur les intervalles courts ; ne sprintez pas pour atteindre la zone."
          }
        }
      }
    },
    "Build strength": {
