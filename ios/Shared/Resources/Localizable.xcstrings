    "Use Start run for GPS recording. This form logs a run you already completed.": {
      "extractionState": "manual",
      "comment": "Used in: WorkoutLoggerView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Start run for GPS recording. This form logs a run you already completed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Iniciar carrera para grabar con GPS. Este formulario registra una carrera ya completada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Iniciar corrida para gravar com GPS. Este formulário registra uma corrida já concluída."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Démarrer la course pour enregistrer avec le GPS. Ce formulaire sert à saisir une course déjà terminée."
          }
        }
      }
    },
    "Use a gentle hill to practice strong, controlled running. Recover on the way down and take extra time to return safely to the start.": {
      "extractionState": "manual",
      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a gentle hill to practice strong, controlled running. Recover on the way down and take extra time to return safely to the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una cuesta suave para practicar una carrera fuerte y controlada. Recupérate al bajar y toma más tiempo si hace falta para volver con seguridad al inicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma subida suave para praticar uma corrida forte e controlada. Recupere na descida e reserve mais tempo para voltar com segurança ao início."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une pente douce pour travailler une course puissante et maîtrisée. Récupérez en descendant et prenez le temps nécessaire pour revenir au départ en sécurité."
