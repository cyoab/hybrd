    "Outdoor GPS recording. Heart rate on iPhone requires a supported heart-rate sensor; Apple Watch measures it from your wrist. Permissions are requested when you start.": {
      "extractionState": "manual",
      "comment": "Used in: RunSessionView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outdoor GPS recording. Heart rate on iPhone requires a supported heart-rate sensor; Apple Watch measures it from your wrist. Permissions are requested when you start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación GPS al aire libre. La frecuencia cardíaca en el iPhone requiere un sensor compatible; el Apple Watch la mide en tu muñeca. Se solicitan permisos al iniciar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação por GPS ao ar livre. A frequência cardíaca no iPhone exige um sensor compatível; o Apple Watch mede pelo pulso. As permissões são solicitadas ao iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement GPS en extérieur. Sur iPhone, la fréquence cardiaque nécessite un capteur compatible ; l’Apple Watch la mesure au poignet. Les autorisations sont demandées au démarrage."
          }
        }
      }
