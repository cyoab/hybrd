    "Milestones are calculated from your current records. Correcting or deleting a record can update the totals and awards attached to it.": {
      "extractionState": "manual",
      "comment": "Used in: TrainingProgressView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Milestones are calculated from your current records. Correcting or deleting a record can update the totals and awards attached to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los logros se calculan a partir de tus registros actuales. Corregir o eliminar un registro puede actualizar los totales y las recompensas asociadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conquistas são calculadas com seus registros atuais. Corrigir ou excluir um registro pode atualizar os totais e as recompensas associadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes sont calculées à partir de vos enregistrements actuels. Corriger ou supprimer un enregistrement peut modifier les totaux et les récompenses associés."
          }
        }
      }
    },
