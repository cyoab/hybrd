    "Build a strong foundation. Use a comfortable load and keep three reps in reserve.": {
      "extractionState": "manual",
      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a strong foundation. Use a comfortable load and keep three reps in reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye una base sólida. Usa una carga cómoda y deja tres repeticiones en reserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa uma base forte. Use uma carga confortável e deixe três repetições na reserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construisez une base solide. Utilisez une charge confortable et gardez trois répétitions en réserve."
          }
        }
      }
    },
    "Build endurance with an hour of easy running. Settle into a sustainable rhythm and keep the finish controlled.": {
      "extractionState": "manual",
      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build endurance with an hour of easy running. Settle into a sustainable rhythm and keep the finish controlled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tu resistencia con una hora de carrera suave. Encuentra un ritmo sostenible y termina de forma controlada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenvolva resistência com uma hora de corrida leve. Encontre um ritmo sustentável e mantenha o controle até o fim."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez votre endurance avec une heure de course facile. Adoptez une allure durable et terminez en contrôle."
          }
        }
      }
    },
