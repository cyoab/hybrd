    "Each distinct day with a logged run or completed strength sets adds one step. Every 10 training days opens another level.": {
      "extractionState": "manual",
      "comment": "Used in: TrainingProgressView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each distinct day with a logged run or completed strength sets adds one step. Every 10 training days opens another level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día distinto con una carrera registrada o series de fuerza completadas añade un paso. Cada 10 días de entrenamiento abren un nuevo nivel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia diferente com corrida registrada ou séries de força concluídas adiciona um passo. A cada 10 dias de treino, um novo nível se abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour distinct avec une course enregistrée ou des séries de musculation terminées ajoute une étape. Tous les 10 jours d’entraînement, un nouveau niveau s’ouvre."
          }
        }
      }
    },
