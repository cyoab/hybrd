    "Begin easy, settle into steady running, then finish the main block with a short controlled effort before cooling down.": {
      "extractionState": "manual",
      "comment": "Persisted English key; localize for display only. Used in: Persisted content",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin easy, settle into steady running, then finish the main block with a short controlled effort before cooling down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza suave, encuentra un ritmo constante y termina el bloque principal con un esfuerzo corto y controlado antes de enfriar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece leve, encontre um ritmo constante e termine o bloco principal com um esforço curto e controlado antes de desacelerar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez doucement, adoptez une allure régulière, puis terminez le bloc principal par un effort court et maîtrisé avant le retour au calme."
          }
        }
      }
    },
