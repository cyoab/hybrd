      "comment": "Used in: ProfileConnectionsView.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only access. You’ll review each value before applying it. Manage sharing in Apple Health. Your imported details stay on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso de solo lectura. Revisarás cada valor antes de aplicarlo. Gestiona los permisos en Salud de Apple. Los datos importados permanecen en este iPhone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso somente leitura. Você revisará cada valor antes de aplicá-lo. Gerencie o compartilhamento no Saúde da Apple. Os dados importados ficam neste iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès en lecture seule. Vous vérifierez chaque valeur avant de l’appliquer. Gérez le partage dans Santé d’Apple. Les données importées restent sur cet iPhone."
          }
        }
      }
    },
